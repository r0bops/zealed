# Copy to .env.local and fill in. Never commit .env.local.

# --- Agent (AI SDK, direct Anthropic API) ---
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-haiku-5-5

# --- Guardrails (USD cents) ---
AGENT_AUTO_LIMIT_CENTS=500
AGENT_APPROVAL_LIMIT_CENTS=2000
AGENT_DAILY_LIMIT_CENTS=2500

# --- Storage ---
DATABASE_PATH=./data/zealed.db

# --- Fulfillment key (seals phone numbers). Generate with: pnpm keygen ---
FULFILL_SECRET_KEY=

# --- Bitrefill REST v2 (Bearer API key). Leave empty to run the labelled SIMULATED catalog. ---
BITREFILL_API_KEY=
BITREFILL_USE_TEST_PRODUCTS=true
BTC_USD_RATE=78000            # fallback + sanity anchor; live BTC/USD comes from Coinbase (Kraken backup), cached 5 min
BTC_USD_LIVE=on               # off = always use BTC_USD_RATE

# --- Zcash (NU7 testnet, shielded unified addresses only) ---
ZCASH_BACKEND=fake            # fake: development only (SIMULATED) | zkool: real watch-only detection via zkool_graphql
ZKOOL_URL=http://127.0.0.1:8000/graphql
ZKOOL_ACCOUNT_ID=             # watch-only (UFVK) account id; printed by scripts/zkool-setup.ts
ZKOOL_PAYER_ID=               # optional: payer account for scripts/zkool-pay.ts test payments
ZKOOL_JWT=                    # set when zkool runs with -j
ZCASH_NETWORK=testnet
ZCASH_LIGHTWALLETD=https://testnet.zec.rocks:443
ZCASH_RECEIVE_UA=             # demo wallet utest1… address (needs an Ironwood or Sapling receiver)
ZCASH_UFVK=                   # demo wallet uviewtest… viewing key (watch-only; never a spending key)
ZCASH_BIRTH=                  # block height the demo wallet was created at
ZCASH_MIN_CONFIRMATIONS=1
ZEC_USD_RATE=30               # fixed demo rate; TAZ has no market price

# Organizer access for /campaigns. Generate at least 32 random characters; never expose to players.
CAMPAIGN_ADMIN_TOKEN=

# --- FROST 2-of-3 sponsor treasury (organizer, co-sponsor, Zealed): one zkool_graphql per participant, localhost, no -j ---
FROST_URLS=http://127.0.0.1:8000/graphql,http://127.0.0.1:8001/graphql,http://127.0.0.1:8002/graphql   # participant order 1,2,3
FROST_NAME=zealed-sponsor-treasury   # group account name on every instance
FROST_MESSAGE_ACCOUNTS=       # per-instance account ids that pay for protocol memos (~0.01 TAZ each); pnpm frost:setup creates them
FROST_ACCOUNT_IDS=            # per-instance group account ids; printed by pnpm frost:setup
FROST_COORDINATOR=1           # participant that builds, aggregates and broadcasts
FROST_SIGNER=2                # the second of the two signers
FROST_TREASURY_UA=            # shared utest1… address sponsors fund; printed by pnpm frost:setup
FROST_TREASURY_UFVK=          # shared uviewtest… viewing key (watch-only; never a share or seed)
FROST_TREASURY_BIRTH=
