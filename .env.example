# Copy to .env.local and fill in. Never commit .env.local.

# --- Agent (AI SDK via Vercel AI Gateway; any provider/model string works) ---
AI_GATEWAY_API_KEY=
AGENT_MODEL=anthropic/claude-haiku-5.5

# --- Guardrails (USD cents) ---
AGENT_AUTO_LIMIT_CENTS=500
AGENT_APPROVAL_LIMIT_CENTS=2000
AGENT_DAILY_LIMIT_CENTS=2500

# --- Storage ---
DATABASE_PATH=./data/zealed.db

# --- Fulfillment key (seals phone numbers). Generate with: pnpm keygen ---
FULFILL_SECRET_KEY=

# --- Bitrefill REST v2 (Bearer API key). Leave empty to run the labelled SIMULATED catalog. ---
BITREFILL_API_KEY=
BITREFILL_USE_TEST_PRODUCTS=true

# --- Zcash (NU7 testnet, shielded unified addresses only) ---
ZCASH_BACKEND=fake            # fake (dev only, shows SIMULATED) | zkool | cipherpay
ZCASH_NETWORK=testnet
ZCASH_LIGHTWALLETD=https://testnet.zec.rocks:443
ZCASH_RECEIVE_UA=             # demo wallet utest1… address (needs an Ironwood or Sapling receiver)
ZCASH_UFVK=                   # demo wallet uviewtest… viewing key (watch-only; never a spending key)
ZCASH_MIN_CONFIRMATIONS=1
ZEC_USD_RATE=30               # fixed demo rate; TAZ has no market price
